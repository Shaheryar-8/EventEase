@page "/account"
@inject UserSessionService Session
@inject NavigationManager Nav

<PageTitle>Sign in · EventEase</PageTitle>

<h1>Sign in</h1>
<p class="text-muted">EventEase remembers you for this browser tab, fills in your details when you register and shows your registrations.</p>

<EditForm Model="_model" OnValidSubmit="SignInAsync" FormName="signin" class="form-narrow">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label" for="name">Name</label>
        <InputText id="name" class="form-control" @bind-Value="_model.Name" autocomplete="name" />
        <ValidationMessage For="() => _model.Name" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <InputText id="email" type="email" class="form-control" @bind-Value="_model.Email" autocomplete="email" />
        <ValidationMessage For="() => _model.Email" />
    </div>
    <button type="submit" class="btn btn-primary">Continue</button>
</EditForm>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private UserSession _model = new();

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (Session.Current is not null) _model = new UserSession { Name = Session.Current.Name, Email = Session.Current.Email };
    }

    private async Task SignInAsync()
    {
        await Session.SignInAsync(_model.Name, _model.Email);
        // Only allow returning to a page inside this app (no open redirects).
        var target = !string.IsNullOrWhiteSpace(ReturnUrl) && !ReturnUrl.Contains("://") && !ReturnUrl.StartsWith("//")
            ? ReturnUrl.TrimStart('/')
            : "events";
        Nav.NavigateTo(target);
    }
}
