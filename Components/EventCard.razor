@* Event Card: shows one event and, in edit mode, lets the user change it.
   Two-way binding: the parent writes <EventCard @bind-Event="item" />. Edits are made on a copy
   and only pushed back through EventChanged when the form is valid and saved. *@

<article class="event-card card h-100 @(IsPast ? "is-past" : "")">
    <div class="card-body d-flex flex-column">
        @if (!_editing)
        {
            <div class="d-flex justify-content-between align-items-start gap-2">
                <h3 class="h5 card-title mb-1">@Event.Name</h3>
                @if (IsPast)
                {
                    <span class="badge text-bg-secondary">Past</span>
                }
                else if (SeatsTaken >= Event.Capacity)
                {
                    <span class="badge text-bg-danger">Full</span>
                }
            </div>
            <p class="event-meta mb-2">
                <span>@Event.Date.ToString("ddd, dd MMM yyyy · h:mm tt")</span><br />
                <span>@Event.Location</span>
            </p>
            <p class="card-text flex-grow-1">@Event.Description</p>
            <div class="seat-bar mb-3" title="@SeatsTaken of @Event.Capacity seats taken">
                <div class="seat-fill" style="width:@FillPercent%"></div>
            </div>
            <p class="small text-muted mb-3">@SeatsTaken / @Event.Capacity seats taken</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-primary" href="@($"events/{Event.Id}")">Details</a>
                @if (!IsPast && SeatsTaken < Event.Capacity)
                {
                    <a class="btn btn-sm btn-outline-primary" href="@($"events/{Event.Id}/register")">Register</a>
                }
                @if (Editable)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="StartEdit">Edit</button>
                }
            </div>
        }
        else
        {
            <EditForm Model="_draft" OnValidSubmit="SaveAsync" FormName="@($"edit-event-{Event.Id}")">
                <DataAnnotationsValidator />
                <div class="mb-2">
                    <label class="form-label" for="@($"name-{Event.Id}")">Name</label>
                    <InputText id="@($"name-{Event.Id}")" class="form-control form-control-sm" @bind-Value="_draft.Name" />
                    <ValidationMessage For="() => _draft.Name" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="@($"date-{Event.Id}")">Date and time</label>
                    <InputDate Type="InputDateType.DateTimeLocal" id="@($"date-{Event.Id}")" class="form-control form-control-sm" @bind-Value="_draft.Date" />
                    <ValidationMessage For="() => _draft.Date" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="@($"loc-{Event.Id}")">Location</label>
                    <InputText id="@($"loc-{Event.Id}")" class="form-control form-control-sm" @bind-Value="_draft.Location" />
                    <ValidationMessage For="() => _draft.Location" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="@($"cap-{Event.Id}")">Capacity</label>
                    <InputNumber id="@($"cap-{Event.Id}")" class="form-control form-control-sm" @bind-Value="_draft.Capacity" />
                    <ValidationMessage For="() => _draft.Capacity" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="@($"desc-{Event.Id}")">Description</label>
                    <InputTextArea id="@($"desc-{Event.Id}")" class="form-control form-control-sm" rows="3" @bind-Value="_draft.Description" />
                    <ValidationMessage For="() => _draft.Description" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary">Save</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                </div>
            </EditForm>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Event Event { get; set; } = default!;
    [Parameter] public EventCallback<Event> EventChanged { get; set; }
    [Parameter] public int SeatsTaken { get; set; }
    [Parameter] public bool Editable { get; set; }

    private bool _editing;
    private Event _draft = new();

    private bool IsPast => Event.Date < DateTime.Now;
    private int FillPercent => Event.Capacity == 0 ? 0 : Math.Min(100, SeatsTaken * 100 / Event.Capacity);

    private void StartEdit()
    {
        _draft = Event.Clone();
        _editing = true;
    }

    private void CancelEdit() => _editing = false;

    private async Task SaveAsync()
    {
        _editing = false;
        await EventChanged.InvokeAsync(_draft.Clone());
    }
}
