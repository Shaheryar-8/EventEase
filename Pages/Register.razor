@page "/events/{Id:int}/register"
@inject EventService Events
@inject RegistrationService Registrations
@inject UserSessionService Session
@inject NavigationManager Nav

@if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else if (_event is null)
{
    <PageTitle>Event not found · EventEase</PageTitle>
    <NotFoundMessage Title="Event not found" Message="@($"You tried to register for event {Id}, which does not exist.")" />
}
else
{
    <PageTitle>Register · @_event.Name · EventEase</PageTitle>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="events">Events</a></li>
            <li class="breadcrumb-item"><a href="@($"events/{_event.Id}")">@_event.Name</a></li>
            <li class="breadcrumb-item active" aria-current="page">Register</li>
        </ol>
    </nav>

    <h1>Register for @_event.Name</h1>
    <p class="event-meta">@_event.Date.ToString("dddd, dd MMMM yyyy · h:mm tt") · @_event.Location</p>

    @if (_result?.Success == true)
    {
        <div class="alert alert-success" role="status">
            <strong>@_result.Message</strong> A confirmation was saved to your registrations.
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" href="my-registrations">View my registrations</a>
            <a class="btn btn-outline-secondary" href="events">Back to events</a>
        </div>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="register" class="form-narrow">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label class="form-label" for="fullName">Full name</label>
                <InputText id="fullName" class="form-control" @bind-Value="_model.FullName" autocomplete="name" />
                <ValidationMessage For="() => _model.FullName" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="email">Email</label>
                <InputText id="email" type="email" class="form-control" @bind-Value="_model.Email" autocomplete="email" />
                <ValidationMessage For="() => _model.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="phone">Phone (optional)</label>
                <InputText id="phone" type="tel" class="form-control" @bind-Value="_model.Phone" autocomplete="tel" />
                <ValidationMessage For="() => _model.Phone" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="seats">Seats</label>
                <InputNumber id="seats" class="form-control" @bind-Value="_model.Seats" min="1" max="5" />
                <ValidationMessage For="() => _model.Seats" />
                <div class="form-text">@_seatsLeft seat(s) left.</div>
            </div>
            <div class="form-check mb-3">
                <InputCheckbox id="terms" class="form-check-input" @bind-Value="_model.AcceptTerms" />
                <label class="form-check-label" for="terms">I agree to the event terms and code of conduct.</label>
                <ValidationMessage For="() => _model.AcceptTerms" />
            </div>

            @if (_result?.Success == false)
            {
                <div class="alert alert-danger" role="alert">@_result.Message</div>
            }

            <button type="submit" class="btn btn-primary" disabled="@_submitting">
                @(_submitting ? "Registering…" : "Register")
            </button>
        </EditForm>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Event? _event;
    private Registration _model = new();
    private RegistrationResult? _result;
    private int _seatsLeft;
    private bool _loading = true;
    private bool _submitting;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _result = null;
        await Session.InitializeAsync();
        _event = await Events.GetByIdAsync(Id);
        if (_event is not null)
        {
            _seatsLeft = Math.Max(0, _event.Capacity - await Registrations.SeatsTakenAsync(_event.Id));
            // State management: a signed-in visitor gets their details filled in.
            _model = new Registration
            {
                EventId = _event.Id,
                FullName = Session.Current?.Name ?? string.Empty,
                Email = Session.Current?.Email ?? string.Empty,
            };
        }
        _loading = false;
    }

    private async Task SubmitAsync()
    {
        if (_submitting) return; // guard against double clicks
        _submitting = true;
        try
        {
            _result = await Registrations.RegisterAsync(_model);
            if (_result.Success)
            {
                // Remember the visitor for the rest of the session.
                if (!Session.IsSignedIn) await Session.SignInAsync(_model.FullName, _model.Email);
            }
            else
            {
                _seatsLeft = Math.Max(0, _event!.Capacity - await Registrations.SeatsTakenAsync(_event.Id));
            }
        }
        finally
        {
            _submitting = false;
        }
    }
}
